# Clé API Anthropic (https://console.anthropic.com) — obligatoire hors mode démo
ANTHROPIC_API_KEY=

# Mode démo : true = résultats simulés, aucun appel IA (pratique pour tester l'UI)
AURA_DEMO_MODE=false

# Profondeur de réflexion de l'IA : low | medium | high
AURA_EFFORT=medium

# Dossier où est stockée la base JSON (classement, scans, battles)
AURA_DATA_DIR=./data
